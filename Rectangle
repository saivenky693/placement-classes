import java.util.Scanner;
class Rect{
    int a,c;
    Rect(int l,int b)
    {
        a=l;
        c=b;
    }
    public void display()
    {
        System.out.println("Area is"+(a*c));
    }
}
public class main
{
    public static void main(String[]args){
        int l,b;
        Scanner a = new Scanner(System.in);
        System.out.println("Enter number of Rectangles: ");
        int n=a.nextInt();
        Rect[ ]r=new Rect[n];
        for(int i=0;i<n;i++)
        {
            System.out.println("Enter Length of the Rect"+(i+1));
            l=a.nextInt();
            System.out.println("Enter Breadth of the Rect"+(i+1));
            b=a.nextInt();
            r[i]=new Rect(l,b);
        }
        System.out.println("Lets see all Area of all Rect: ");
        for(int i=0;i<n;i++)
        {
            System.out.println("Area of Rectangle"+(i+1));
            r[i].display();
        }

    }
}
